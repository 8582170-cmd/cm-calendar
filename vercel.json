{
 "functions": {
  "api/*.js": {
   "includeFiles": "{assets/plans.js,assets/yz.js,api/_hdate/**}"
  }
 },
 "crons": [
  {
   "path": "/api/cron-reminders",
   "schedule": "0 4 * * *"
  }
 ],
 "rewrites": [
  {
   "source": "/admin",
   "destination": "/admin.html"
  },
  {
   "source": "/donate",
   "destination": "/donate.html"
  },
  {
   "source": "/countdown",
   "destination": "/countdown.html"
  },
  {
   "source": "/terms",
   "destination": "/terms.html"
  },
  {
   "source": "/privacy",
   "destination": "/privacy.html"
  },
  {
   "source": "/simple",
   "destination": "/simple.html"
  },
  {
   "source": "/accessibility",
   "destination": "/accessibility.html"
  }
 ]
}