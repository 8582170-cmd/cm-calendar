{
 "functions": {
  "api/*.js": {
   "includeFiles": "{assets/plans.js,assets/yz.js,api/_hdate/**,sitemap.xml}"
  }
 },
 "crons": [
  {
   "path": "/api/cron-reminders",
   "schedule": "0 4 * * *"
  }
 ],
 "rewrites": [
  {
   "source": "/torah",
   "destination": "/api/pricing?pg=_torah"
  },
  {
   "source": "/torah/",
   "destination": "/api/pricing?pg=_torah"
  },
  {
   "source": "/admin",
   "destination": "/admin.html"
  },
  {
   "source": "/donate",
   "destination": "/donate.html"
  },
  {
   "source": "/countdown",
   "destination": "/countdown.html"
  },
  {
   "source": "/terms",
   "destination": "/terms.html"
  },
  {
   "source": "/privacy",
   "destination": "/privacy.html"
  },
  {
   "source": "/simple",
   "destination": "/simple.html"
  },
  {
   "source": "/accessibility",
   "destination": "/accessibility.html"
  },
  {
   "source": "/new",
   "destination": "/new.html"
  },
  {
   "source": "/p/:slug",
   "destination": "/api/pricing?pg=:slug"
  },
  {
   "source": "/sitemap-pages.xml",
   "destination": "/api/pricing?pg=_sitemap"
  }
 ]
}