# העתק קובץ זה ל-.env.local ומלא את הערכים האמיתיים שלך.
# לעולם אל תעלה את .env.local לגיטהאב! (הוא כבר ב-.gitignore)

# מ-Supabase: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# מפתח service_role - רק לשימוש בצד השרת (API routes), לעולם לא בצד הלקוח!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# פרטי ספק הסליקה (Grow / Cardcom / וכו') - נמלא בשלב חיבור התשלומים
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_TERMINAL=
